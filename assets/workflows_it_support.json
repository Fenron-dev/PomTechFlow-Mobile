        { "id": "wfi_tpl_002_07", "itemText": "Firewall-Regeln und VPN-Konflikte ausschließen", "sortOrder": 6 },
        { "id": "wfi_tpl_002_08", "itemText": "Netzwerktreiber und Firmware auf aktuellem Stand", "sortOrder": 7 },
        { "id": "wfi_tpl_002_09", "itemText": "Lösung umgesetzt, Verbindung über 5 Min stabil getestet", "sortOrder": 8 },
        { "id": "wfi_tpl_002_10", "itemText": "Befund und Maßnahme dokumentiert", "sortOrder": 9 }
      ]
    },
