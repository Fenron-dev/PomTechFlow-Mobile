    {
      "id": "wf_tpl_002",
      "name": "Netzwerk-Diagnose & Fehlerbehebung",
      "description": "Systematische Diagnose bei Netzwerkproblemen (kein Internet, langsame Verbindung, Drops)",
      "items": [
        { "id": "wfi_tpl_002_01", "itemText": "Problem genau beschreiben: welche Geräte, seit wann, dauerhaft oder sporadisch", "sortOrder": 0 },
        { "id": "wfi_tpl_002_02", "itemText": "Physikalische Ebene prüfen (Kabel, LED-Status am Switch/Router)", "sortOrder": 1 },
        { "id": "wfi_tpl_002_03", "itemText": "IP-Konfiguration prüfen (ipconfig /all) – DHCP oder statisch", "sortOrder": 2 },
        { "id": "wfi_tpl_002_04", "itemText": "Gateway und DNS anpingen (ping 8.8.8.8, ping google.com)", "sortOrder": 3 },
        { "id": "wfi_tpl_002_05", "itemText": "Router-/Switch-Logs auf Fehler prüfen", "sortOrder": 4 },
